# Canonical public HTTPS origin. Required for a production deployment.
# Use http://127.0.0.1:3000 only for local testing.
APP_ORIGIN=

# Free Upstash Redis database for shared public API and AI request limits.
# Select the Free plan, not Pay as You Go. Do not add billing for this demo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_IP_HASH_SECRET=
# Vercel automatically uses its trusted client IP header. For another host,
# configure a header only when the reverse proxy overwrites it.
RATE_LIMIT_CLIENT_IP_HEADER=
# Leave blank for Redis in production. memory is restricted to local testing.
RATE_LIMIT_BACKEND=

# Server-side Storefront API credentials from the Headless sales channel.
# Leave BOTH blank to use the clearly labelled portfolio catalog without checkout.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Set true only after verifying the store uses a test payment gateway/sandbox.
# This is an explicit operator attestation, not automatic gateway verification.
SHOPIFY_TEST_CHECKOUT_ENABLED=false

# Free-tier Gemini only. A key alone does not enable requests.
# Confirm the PERSONAL project shows Free Tier with Cloud Billing disabled.
# This is an operator attestation; the API key cannot prove billing settings.
# Never upgrade this project's billing. Global caps: 5/minute, 50/UTC day.
ENABLE_LIVE_AI=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, only for the local Shopify catalog seed script. Never expose to a client.
# Scopes: read_products, write_products, read_locations, write_inventory,
# read_publications, write_publications. Use only a dedicated test store.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SEED_LOCATION_ID=
SHOPIFY_PUBLICATION_ID=
